# Local Postgres (alchemy.run.ts reads these; alchemy deploy loads .env)
POSTGRES_USER=magpie
POSTGRES_PASSWORD=
POSTGRES_DB=magpie
POSTGRES_PORT=5433
POSTGRES_IMAGE_TAG=0.8.2-pg18-trixie

# API
DATABASE_URL=postgres://magpie:<password>@localhost:5433/magpie
PORT=3000
DATA_DIR=./data

# Optional: enables TMDB overviews, posters, trailers. Either the v3 API key or the v4 Read Access Token.
TMDB_API_TOKEN=
# Optional: enables Trakt sync. Client ID of a Trakt app (https://app.trakt.tv/settings/apps) whose redirect URIs
# include $ORIGIN/trakt/callback (http://localhost:5173/trakt/callback for local dev). No client secret: sign-in uses PKCE.
TRAKT_CLIENT_ID=

# Passkeys are bound to this domain. ORIGIN is the URL the web app is served from.
RP_ID=localhost
ORIGIN=http://localhost:5173

# Cloudflare deploy (cloudflare.run.ts). CLOUDFLARE_API_TOKEN is supplied at deploy time, not stored here.
CLOUDFLARE_ACCOUNT_ID=
PROD_DATABASE_URL=
# Hostname the Worker serves. Passkeys are bound to it, so changing it means everyone re-registers via a fresh invite.
APP_DOMAIN=
# Usage alerts (optional). A read-only Cloudflare token with Account Analytics: Read, and where to mail warnings.
# The sender must be on a zone in this account; Email Routing gets enabled on it.
CF_ANALYTICS_TOKEN=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
