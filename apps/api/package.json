{
  "name": "@magpie/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "ingest": "NODE_OPTIONS=--max-old-space-size=8192 tsx --env-file=../../.env src/ingest/main.ts",
    "embed": "tsx --env-file=../../.env src/ingest/embed.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "invite": "tsx --env-file=../../.env src/invite.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.5",
    "@effect/sql-pg": "4.1.5",
    "@huggingface/transformers": "4.3.2",
    "@magpie/contract": "workspace:*",
    "@simplewebauthn/server": "14.1.0",
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.5",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "5",
    "vitest": "^5.1.1"
  }
}
